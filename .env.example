# Isi lalu simpan sebagai .env (jangan commit file .env ke git)

# Bot Token — dari https://discord.com/developers/applications > Bot > Reset Token
DISCORD_TOKEN=

# Application ID — dari halaman General Information aplikasi bot kamu
CLIENT_ID=

# ID server (guild) tempat kamu pakai bot ini sendirian.
# Command guild-scoped langsung muncul (~instan), beda sama global yang bisa
# lama sampai 1 jam — penting karena ini bot personal, dev loop-nya cepat.
GUILD_ID=
